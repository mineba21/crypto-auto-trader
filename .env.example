# Copy to .env (never commit). Keys are only needed for LIVE; PAPER/BACKTEST need none.
# Create the Upbit key WITHOUT withdrawal permission, with IP allow-list, "자산조회" + "주문조회" + "주문하기" only.
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
# HMAC secret used to sign/verify config/live_approval.json (keep offline; different from the API secret)
CAT_LIVE_APPROVAL_SECRET=
# Must equal I_ACCEPT_REAL_MONEY_RISK for LIVE to start (third, independent gate)
CAT_ENABLE_LIVE=
CAT_CONFIG=config/default.yaml
