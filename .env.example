# Copy to .env (never commit). PAPER needs no exchange keys.
# --- notifications (Telegram). Any of TELEGRAM_BOT_TOKEN / TELEGRAM_TOKEN / TG_BOT_TOKEN and
#     TELEGRAM_CHAT_ID / TG_CHAT_ID are recognised. scripts/import_telegram_env.sh can copy them.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# --- dead-man's switch pings (e.g. https://hc-ping.com/<uuid>); alert when the Mac sleeps or a service dies
HEALTHCHECK_URL_COLLECTOR=
HEALTHCHECK_URL_PAPER=
CAT_NOTIFY_PREFIX=[crypto-auto-trader]
# --- LIVE only (leave empty). Upbit key WITHOUT withdrawal permission, IP allow-listed.
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
CAT_LIVE_APPROVAL_SECRET=
CAT_ENABLE_LIVE=
CAT_CONFIG=config/default.yaml
